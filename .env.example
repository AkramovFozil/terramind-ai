# Copy this file to .env and put your own key there. Never commit .env.
# Free key: https://portal.opentopography.org (My Account -> Request API Key)
OPENTOPO_API_KEY=

# AI explanation (OpenRouter). Server-side only: never put this key in browser code.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id
OPENROUTER_MODEL=openai/gpt-4o
